<?xml version="1.0" encoding="utf-8"?>
<!-- 次要按钮：与加入按钮同形状同圆角，浅底 + 描边，区分主次操作 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/secondaryPressedBg" />
            <stroke
                android:width="1dp"
                android:color="@color/primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/secondaryBg" />
            <stroke
                android:width="1dp"
                android:color="@color/secondaryStroke" />
        </shape>
    </item>
</selector>
